# Copy this file to backend/.env and fill in as needed.
#
# For Step 1 (ingest) you only need DATABASE_URL — everything below that is
# commented "not needed yet" can stay blank until we build that pipeline step.

# --- Database ------------------------------------------------------------
# Local dev (docker compose up postgres): matches docker-compose.yml's
# postgres service. Swap for your Supabase connection string when ready.
DATABASE_URL=postgres://cutroom:cutroom@localhost:5432/cutroom

# --- API service -----------------------------------------------------------
PORT=3000
# Base URL clients use to reach the API — used to build /files/:key links
# when STORAGE_DRIVER=local. Keep as localhost for local dev either way
# (native or docker compose): the container always publishes 3000 to the host.
API_PUBLIC_URL=http://localhost:3000
# Comma-separated allowed origins, or "*" for local dev.
CORS_ORIGIN=*

# --- Worker --------------------------------------------------------------
POLL_INTERVAL_MS=2000

# Optional. Without this, YouTube downloads are capped around 360p (the
# android client's only progressive format that doesn't need a PO token we
# can't mint). A cookies.txt from a real, logged-in YouTube session unlocks
# real HD (up to 1080p). To get one: install a browser extension like
# "Get cookies.txt LOCALLY" (Chrome/Firefox), export cookies.txt while logged
# into youtube.com, save it to backend/secrets/cookies.txt (gitignored), then
# uncomment the line below. If this path doesn't exist or the download fails,
# ingest automatically falls back to the reliable ~360p path — never a hard failure.
# YTDLP_COOKIES_FILE=/app/secrets/cookies.txt

# --- Storage ---------------------------------------------------------------
# "local"  -> stores files on disk for $0, zero setup. Default — use this to
#             get your first video -> clips run working for free.
# "r2"     -> Cloudflare R2 (S3-compatible). Free tier: 10GB-month storage,
#             1M Class A ops/mo, 10M Class B ops/mo — plenty for testing.
STORAGE_DRIVER=local

# Only used when STORAGE_DRIVER=local. Native/host dev: relative path from
# both apps/api and apps/worker (both 2 levels under backend/), so it resolves
# to the same backend/.data/storage folder either way. docker-compose.yml
# overrides this to /data/storage (a shared volume) for the containers.
LOCAL_STORAGE_PATH=../../.data/storage

# Only used when STORAGE_DRIVER=r2 — get these from the Cloudflare dashboard:
# R2 > Manage API Tokens > Create API Token (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Not needed until Step 2 (transcribe) -----------------------------------
# Free tier — check current limits at console.groq.com. Also powers analyze
# below when ANALYZE_PROVIDER=groq, so this one key covers both steps 2 and 3.
GROQ_API_KEY=

# --- Not needed until Step 3 (analyze) --------------------------------------
# "groq"      -> free, reuses GROQ_API_KEY above, no separate signup. Default —
#                use this to get the full pipeline running end-to-end for $0.
# "anthropic" -> paid (Claude Haiku, ~$1/$5 per 1M input/output tokens) —
#                needs real credits at console.anthropic.com > Plans & Billing.
#                Generally sharper scoring/hooks; swap to this once you're
#                past free-tier testing.
ANALYZE_PROVIDER=groq

# Only used when ANALYZE_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
