# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Env files — never commit real secrets
.env
.env.*
!.env.example
!*/.env.example

# Backend build output
backend/apps/*/dist
backend/packages/*/dist

# Local dev "storage" (STORAGE_DRIVER=local) — downloaded/rendered video files
backend/.data/

# Optional yt-dlp cookies.txt (real YouTube session — never commit this)
backend/secrets/*
!backend/secrets/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
